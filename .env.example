# Token do Apify (Settings > Integrations). Fica SOMENTE no servidor.
# Sem token, o app roda em modo demonstração com dados fictícios.
APIFY_TOKEN=

# Chave da Anthropic (opcional). Gera as ramificações de busca em português.
# Sem ela, o app usa sugestões simples por regra.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Quantas horas um resultado fica em cache antes de pagar o Apify de novo
CACHE_TTL_HOURS=6
