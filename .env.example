# ===== OBRIGATÓRIA =====
# Token do Apify (console.apify.com > Settings > API & Integrations). Fica SOMENTE no servidor.
# Sem ele, o app roda em modo demonstração com dados fictícios.
APIFY_TOKEN=

# ===== RECOMENDADAS (proteção do seu saldo) =====
# Redis da Upstash (upstash.com, plano grátis). Faz o cache e os limites valerem para TODAS as
# instâncias da Vercel. Sem isso, cada instância tem a sua memória e a proteção fica fraca.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Teto diário de execuções pagas, somando todos os usuários. Padrões abaixo, pensados para o
# plano gratuito do Apify (US$ 5/mês). Uma busca completa usa 2 execuções. Suba conforme o seu plano.
# DAILY_SEARCH_LIMIT=60
# DAILY_COMMENTS_LIMIT=100
# DAILY_EXPAND_LIMIT=500

# Horas que uma busca fica em cache antes de pagar o Apify de novo (padrão 6)
CACHE_TTL_HOURS=24

# ===== OPCIONAIS =====
# Chave da Anthropic: gera as sugestões de busca com IA. Sem ela, usa sugestões simples.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
